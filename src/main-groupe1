    from src import visualisation as v
    x_vals = np.arange(config.ZONE["x_min"], config.ZONE["x_max"] + 1e-9, config.ZONE["pas"])
    y_vals = np.arange(config.ZONE["y_min"], config.ZONE["y_max"] + 1e-9, config.ZONE["pas"])
