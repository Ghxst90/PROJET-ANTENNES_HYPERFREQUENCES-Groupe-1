MODULES = {                      # clé : (fichier testé, responsable, démo)
    "direct":        ("canal_direct.py",  "Aroung",   demo_direct),
    "ris":           ("canal_ris.py",     "Tsala",    demo_ris),
    "metriques":     ("metriques.py",     "Aissatou", demo_metriques),
    "optimisation":  ("optimisation.py",  "Aroung",   demo_optimisation),
    "visualisation": ("visualisation.py", "Tsala",    demo_visualisation),
    "simulation":    ("simulation.py",    "Tsofack",  demo_simulation),
    "sensibilite":   ("sensibilite.py",   "Vouffo",   demo_sensibilite),
}


def executer(cle, graine):
    """Lance la démo d'un module et renvoie 'ok', 'a_faire' ou 'erreur'."""
    fichier, responsable, demo = MODULES[cle]
    print(f"\n=== {cle} : {fichier} ({responsable}) ===")
    _ECHECS.clear()
    try:
        demo(graine)
    except NotImplementedError as e:
        trace = traceback.extract_tb(e.__traceback__)[-1]
        print(f"  [A FAIRE] fonction pas encore écrite : {os.path.basename(trace.filename)} / {trace.name}  ({e})")
        return "a_faire"
    except Exception:
        print("  [ERREUR] la démo a planté (vérifier la fonction concernée) :")
        traceback.print_exc(limit=-3)
        return "erreur"
    return "erreur" if _ECHECS else "ok"


def main(argv=None):
    parseur = argparse.ArgumentParser(description="Teste les fonctions phares de chaque module du projet RIS.")
    parseur.add_argument("commande", nargs="*", default=["etat"],
                         help="etat, ou un ou plusieurs modules : " + ", ".join(MODULES))
    parseur.add_argument("--graine", type=int, default=0, help="graine des algorithmes d'optimisation")
    args = parseur.parse_args(argv)

    a_lancer = list(MODULES) if "etat" in args.commande else args.commande
    inconnus = [c for c in a_lancer if c not in MODULES]
    if inconnus:
        parseur.error(f"module inconnu : {', '.join(inconnus)} (choix : etat, {', '.join(MODULES)})")

    statuts = {cle: executer(cle, args.graine) for cle in a_lancer}

    libelles = {"ok": "[OK]", "a_faire": "[A FAIRE]", "erreur": "[ERREUR]"}
    print("\n" + "=" * 60 + "\nRÉSUMÉ")
    for cle, st in statuts.items():
        print(f"  {cle:14s} {libelles[st]:10s} {MODULES[cle][0]} ({MODULES[cle][1]})")
    return 1 if "erreur" in statuts.values() else 0


if __name__ == "__main__":
    try:
        sys.stdout.reconfigure(encoding="utf-8")     # accents corrects dans PowerShell
    except Exception:
        pass
    sys.exit(main())
