    controle("carte_sinr : figure enregistrée dans figures/", os.path.exists(f1))
    v.carte_comparaison(grille - 10, grille, x_vals, y_vals, config.POS_BS, config.POS_RIS, config.OBSTACLES, f2)
    controle("carte_comparaison : figure enregistrée", os.path.exists(f2))
    v.tracer_courbe([1, 2, 3], [1.0, 4.0, 9.0], "Test courbe", "x (unité)", "y (unité)", f3)
    controle("tracer_courbe : figure enregistrée", os.path.exists(f3))


def demo_simulation(graine):
    from src import simulation as sim
    s = sim.construire_scenario()
    cles = ["pos_bs", "pos_ris", "obstacles", "f_hz", "x_vals", "y_vals", "hauteur_ue", "pos_elements"]
    controle("construire_scenario : clés attendues", all(c in s for c in cles))
    forme = (len(s["y_vals"]), len(s["x_vals"]))
    sans = sim.simuler_grille(s)
    ana = sim.simuler_grille(s, "analytique")
    controle(f"simuler_grille : tableau de forme {forme}", np.shape(sans) == forme and np.shape(ana) == forme)
    controle("RIS optimal : jamais pire que sans RIS", bool(np.all(ana >= sans - 1e-9)),
             f"SINR moyen {np.mean(sans):.1f} dB sans RIS, {np.mean(ana):.1f} dB avec")
    res = sim.lancer_comparaison(s)
    controle("lancer_comparaison : dictionnaire de résultats", isinstance(res, dict) and len(res) > 0)
    for cle, val in res.items():
        info(f"{cle} = {val:.3g}")


