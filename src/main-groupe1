"""
main.py — Point d'entrée du projet RIS : appelle les fonctions phares de chaque module.

Lancement (depuis la racine du dépôt) :

    python main.py                  affiche l'état de TOUS les modules (équivaut à « etat »)
    python main.py etat             idem : [OK], [A FAIRE] ou [ERREUR] pour chaque module
    python main.py direct           teste canal_direct.py       (Aroung)
    python main.py ris              teste canal_ris.py          (Tsala)
    python main.py metriques        teste metriques.py          (Aissatou)
    python main.py optimisation     teste optimisation.py       (Aroung)
    python main.py visualisation    teste visualisation.py      (Tsala)
    python main.py simulation       teste simulation.py         (Tsofack)
    python main.py sensibilite      teste sensibilite.py        (Vouffo)
    python main.py direct ris       plusieurs modules à la suite

Option : --graine N  (graine des algorithmes d'optimisation, 0 par défaut)

Principe :
  - chaque module a une fonction « demo_... » ci-dessous qui appelle ses fonctions
    principales et affiche des contrôles [OK] / [ECHEC] avec les valeurs attendues ;
  - si une fonction n'est pas encore écrite (NotImplementedError), le main ne plante pas :
    il affiche [A FAIRE] avec le fichier et la fonction concernés, et passe au module suivant ;
  - pour AJOUTER un test : ajouter des lignes controle(...) dans la demo du module.
"""
import argparse
import os
import sys
import traceback

import numpy as np

from src import config

RACINE = os.path.dirname(os.path.abspath(__file__))
_ECHECS = []        # contrôles échoués pendant la démo en cours


# ============================================================================
# Outils d'affichage
# ============================================================================
def controle(libelle, condition, detail=""):
    """Affiche [OK] ou [ECHEC] pour une vérification, et mémorise les échecs."""
    etat = "OK   " if condition else "ECHEC"
    suite = f"  ->  {detail}" if detail else ""
    print(f"  [{etat}] {libelle}{suite}")
    if not condition:
        _ECHECS.append(libelle)


def info(texte):
    print(f"         {texte}")


def _chemin_fig(nom):
    return os.path.join(RACINE, "figures", nom)


def _utilisateur_test():
    """Un utilisateur dans l'ombre de l'immeuble (même point pour toutes les démos)."""
    return np.array([40.0, 0.0, config.HAUTEUR_UE])


def _elements_ris():
    from src import canal_ris
    return canal_ris.positions_elements(config.POS_RIS, config.N_X, config.N_Y,
                                        config.PAS_ELEMENTS)


# ============================================================================
# Démos : une par module (modifier ou compléter ici pour tester d'autres cas)
# ============================================================================
def demo_direct(graine):
    from src import canal_direct as cd
    pl1 = cd.perte_espace_libre(config.F_HZ, 1.0)
    pl10 = cd.perte_espace_libre(config.F_HZ, 10.0)
    controle("perte à 1 m, 39 GHz (attendu : environ 64,26 dB)", abs(pl1 - 64.26) < 0.2, f"{pl1:.2f} dB")
    controle("perte : +20 dB par décade de distance", abs(pl10 - pl1 - 20.0) < 1e-6, f"{pl10 - pl1:.2f} dB")

    derriere = np.array([50.0, 0.0, config.HAUTEUR_UE])
    visible = np.array([50.0, 40.0, config.HAUTEUR_UE])
    controle("trajet derrière l'immeuble : bloqué", bool(cd.est_bloque(config.POS_BS, derriere, config.OBSTACLES)))
    controle("trajet dégagé : non bloqué", not bool(cd.est_bloque(config.POS_BS, visible, config.OBSTACLES)))
    controle("atténuation de blocage", cd.attenuation_blocage(True) == config.ATTENUATION_BLOCAGE_DB
             and cd.attenuation_blocage(False) == 0.0)

    h_bloque = cd.canal_direct(config.POS_BS, derriere, config.F_HZ, config.OBSTACLES)
    h_libre = cd.canal_direct(config.POS_BS, derriere, config.F_HZ, [])
    controle("h_d est un nombre complexe d'amplitude < 1", np.iscomplexobj(h_bloque) and abs(h_bloque) < 1,
             f"|h_d| = {20 * np.log10(abs(h_bloque)):.1f} dB")
    controle("le blocage ajoute 30 dB de perte",
             abs(20 * np.log10(abs(h_libre) / abs(h_bloque)) - config.ATTENUATION_BLOCAGE_DB) < 1e-6)


def demo_ris(graine):
    from src import canal_ris as cr
    ue = _utilisateur_test()
    n = config.N_ELEMENTS
    el = _elements_ris()
    controle(f"positions des éléments : forme ({n}, 3)", el.shape == (n, 3), f"forme {el.shape}")
    g = cr.canal_bs_ris(config.POS_BS, el, config.F_HZ)
    h_r = cr.canal_ris_ue(el, ue, config.F_HZ)
    controle("g et h_r : vecteurs complexes de taille N",
             g.shape == (n,) and h_r.shape == (n,) and np.iscomplexobj(g) and np.iscomplexobj(h_r))
    theta = cr.matrice_reflexion(np.zeros(n))
    controle("matrice de réflexion : N x N diagonale", theta.shape == (n, n) and np.allclose(theta, np.diag(np.diag(theta))))
    # h_d = 0 pour isoler le test du module canal_ris
    h = cr.canal_total(0j, h_r, g, np.zeros(n))
    controle("canal_total (phases nulles) = somme des h_r * g", abs(h - np.sum(h_r * g)) < 1e-15,
             f"|h| = {20 * np.log10(abs(h)):.1f} dB")


