             and res["couverture_avec"] > res["couverture_sans"])


def demo_optimisation(graine):
    from src import canal_direct as cd, canal_ris as cr, optimisation as o
    ue = _utilisateur_test()
    el = _elements_ris()
    h_d = cd.canal_direct(config.POS_BS, ue, config.F_HZ, config.OBSTACLES)
    g = cr.canal_bs_ris(config.POS_BS, el, config.F_HZ)
    h_r = cr.canal_ris_ue(el, ue, config.F_HZ)

    theta = o.phases_analytiques(h_d, h_r, g)
    controle("phases analytiques dans [0, 2*pi[", theta.min() >= 0 and theta.max() < 2 * np.pi)
    h = cr.canal_total(h_d, h_r, g, theta)
    attendu = abs(h_d) + np.sum(np.abs(h_r * g))
    controle("phases analytiques : les amplitudes s'additionnent", abs(abs(h) - attendu) / attendu < 1e-9)

    sans = o.fonction_objectif(np.zeros(len(g)), h_d, 0 * h_r, g)
    ana = o.fonction_objectif(theta, h_d, h_r, g)
    controle("le RIS optimal améliore le SINR", ana >= sans, f"sans RIS {sans:.1f} dB, analytique {ana:.1f} dB")

    for bits in (2, 1):
        q = o.quantifier_phases(theta, bits)
        pas = 2 * np.pi / 2 ** bits
        controle(f"quantification {bits} bit(s) : niveaux permis", np.allclose(q / pas, np.round(q / pas), atol=1e-9))
        info(f"SINR avec {bits} bit(s) : {o.fonction_objectif(q, h_d, h_r, g):.1f} dB")

    for nom, algo in (("génétique", o.optimiser_genetique), ("PSO", o.optimiser_pso)):
        try:
            phases, historique = algo(h_d, h_r, g, n_iterations=100, graine=graine)
        except NotImplementedError:
            info(f"{nom} : pas encore écrit (optionnel pour le PSO)")
            if nom == "génétique":
                raise
            continue
        score = o.fonction_objectif(phases, h_d, h_r, g)
        controle(f"{nom} : à moins de 1 dB de la solution analytique", ana - score < 1.0,
                 f"{score:.1f} dB (écart {ana - score:.2f} dB)")
        controle(f"{nom} : historique de convergence", len(historique) > 0)


